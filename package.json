{
  "name": "dsh-read-image-view",
  "version": "0.4.0",
  "description": "Display DSH read_image results as complete inline previews and a keyboard/touch image gallery, with native-resolution zoom and session-authorized loading. 在 DSH 对话中完整预览图片，支持多图切换、键盘与触控缩放。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./read-image-core": "./lib/read-image-core.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "test",
    "docs",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "PUBLISH.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "test": "node --test test/*.test.mjs",
    "e2e": "node test/e2e-read-image.mjs",
    "test:browser": "node test/browser-regression.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "esbuild": "0.25.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pngjs": "7.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "read-image",
    "image",
    "attachment",
    "web",
    "ui",
    "conversation"
  ],
  "author": "Yu-tao-Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yu-tao-Li/dsh-read-image-view.git"
  },
  "bugs": {
    "url": "https://github.com/Yu-tao-Li/dsh-read-image-view/issues"
  },
  "homepage": "https://github.com/Yu-tao-Li/dsh-read-image-view#readme",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  }
}
